const STATS={"hero":[80,24,12,19,1],"blade":[58,20,15,22,1],"ranger":[52,24,14,17,3],"medic":[54,40,11,12,2],"engineer":[68,28,10,18,2],"warden":[96,16,8,17,1]}

static func definition(unit: Dictionary) -> Dictionary:
 return CATALOG.get(unit.get("character_id",""),{})

static func create(character_id: String,actor_id: String="") -> Dictionary:
 if not CATALOG.has(character_id):return {}
 var d=CATALOG[character_id]
 var row=STATS[d.job]
 var unit={"id":("hero" if d.job=="hero" else character_id) if actor_id=="" else actor_id,"character_id":character_id,"name":d.name,"role":Jobs.JOBS[d.job].name,"profession":d.job,"identity":("团长" if d.job=="hero" else "佣兵")+" · "+d.title,"appearance":d.job,"max_hp":row[0],"hp":row[0],"max_mp":row[1],"mp":row[1],"speed":row[2],"power":row[3],"range":row[4],"side":0,"ap":4,"cell":Vector2i.ZERO}
 Jobs.normalize(unit)
 return unit

static func starting_party(captain: String="shen") -> Array:
 if captain not in CAPTAINS:return []
 var party=[create(captain)]
 var ids=["blade","ranger","medic","engineer","warden"]
 for i in STARTERS.size():party.append(create(STARTERS[i],ids[i]))
 return party

static func migrate(unit: Dictionary):
 if unit.has("character_id"):return
 var legacy={"hero":"shen","blade":"aling","ranger":"ya","medic":"bai","engineer":"li","warden":"yue"}
 var id=legacy.get(unit.id,"")
 if id=="":
  for candidate in CATALOG:
   if CATALOG[candidate].name==unit.name:id=candidate;break
